{
  "name": "kripto-terminali",
  "productName": "Kripto Terminali",
  "version": "0.8.0",
  "description": "Türkçe kripto araştırma ve sanal işlem masaüstü uygulaması",
  "author": "Kripto Terminali",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "test:ui": "node scripts/check-ui.cjs"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "lightweight-charts": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "playwright": "^1.58.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.4"
  },
  "config": {
    "forge": "./forge.config.cjs"
  }
}
